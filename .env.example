# Every variable the app reads. All optional: the app runs with none of them.
# Copy to .env.local and fill only what you need. Never commit real values.
# What each one does: README.md, "Running it".

# Redis (Upstash REST). Local dev against the production store writes to production: see the verify skill.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (alternative names for the same two)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Telegram alerts bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# maintainer chat for the discovery digest, multiplier changes and basket publishes
TELEGRAM_ADMIN_CHAT_ID=

# Vercel Cron auth. Required on the live site: without it every cron route refuses.
CRON_SECRET=

# x402 pay-per-call API (all three, or the routes answer 503)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# public receiving address, not a secret
X402_PAYOUT_ADDRESS=

# Baskets on Glider. Production-only API: use a read-only key locally (CLAUDE.md).
GLIDER_API_KEY=
GLIDER_STRATEGY_ID=
# GLIDER_API_BASE=https://api.glider.fi/v2
# BASKET_AUTOPUBLISH=1

# Public WalletConnect / Reown project id (phone wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set by Vercel itself (used for absolute URLs), not by you:
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL

# next dev only: pretend to be in this country so the region gate opens
# DEV_GEO_COUNTRY=DE
